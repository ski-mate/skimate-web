# Canonical origin. Leave unset locally; production is getalpline.com.
NEXT_PUBLIC_APP_URL=https://getalpline.com

# MapTiler (NEXT_PUBLIC_ prefix required — the key is read from client components)
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key

# Supabase (email signups)
# Server-only — no NEXT_PUBLIC_ prefix; the secret key bypasses RLS and must
# never be shipped to the browser.
SUPABASE_URL=https://kjnuzuagvjkwbsyxmqep.supabase.co
SUPABASE_SECRET_KEY=<from Supabase dashboard: Project Settings → API keys → secret key>

# ── Ingestion Console (/console) ─────────────────────────────────────────────
# Internal tooling for resort onboarding. Everything under /console is behind
# Supabase auth and an explicit email allow-list.
#
# With SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY unset, /console runs
# unauthenticated in development (with a banner) and refuses to render at all
# in production. It never falls back to open access on a real deployment.
SUPABASE_PUBLISHABLE_KEY=<Supabase dashboard: Project Settings → API keys → publishable key>
# Comma-separated. Empty means nobody — an unset allow-list must not mean
# "everyone with an account in the Supabase project".
CONSOLE_ALLOWED_EMAILS=analyst@example.com

# Which data plane the console talks to. Unset or "mock" runs against the
# bundled fixtures with no backend. Set to "real" once alpline-backend exposes
# /ingestion/* (see src/app/(console)/GAPS.md).
INGESTION_API_MODE=mock
# INGESTION_API_URL=https://alpline-api-prod-xxxx.run.app
# INGESTION_API_TOKEN=<service token for the /ingestion namespace>
