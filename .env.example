# Canonical origin. Leave unset locally; production is getalpline.com.
NEXT_PUBLIC_APP_URL=https://getalpline.com

# MapTiler (NEXT_PUBLIC_ prefix required — the key is read from client components)
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key

# Supabase (email signups)
# Server-only — no NEXT_PUBLIC_ prefix; the secret key bypasses RLS and must
# never be shipped to the browser.
SUPABASE_URL=https://kjnuzuagvjkwbsyxmqep.supabase.co
SUPABASE_SECRET_KEY=<from Supabase dashboard: Project Settings → API keys → secret key>
